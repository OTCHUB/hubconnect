# Copy to .env — never commit real values.
HELIUS_API_KEY=
HUB_CLUSTER=devnet
# Devnet RPC (Helius preferred; falls back to public devnet when key is empty)
HUB_RPC_URL=https://devnet.helius-rpc.com/?api-key=${HELIUS_API_KEY}
# Devnet deployer / funder wallet (never reused on mainnet)
HUB_WALLET=~/.config/solana/hubconnect-devnet.json
# §B5.1 devnet funder guard — abort test run if funder drops below this
HUB_DEVNET_MIN_SOL=2
# Mainnet genesis-airdrop scripts (mainnet-airdrop-snapshot.ts / mainnet-distribute.ts) only —
# deliberately separate from HUB_RPC_URL/HUB_WALLET above so a devnet .env can never accidentally
# touch mainnet. No default keypair path: HUB_MAINNET_WALLET must be set explicitly.
HUB_MAINNET_RPC_URL=https://mainnet.helius-rpc.com/?api-key=${HELIUS_API_KEY}
HUB_MAINNET_WALLET=
# mainnet-distribute.ts --reward --fund only: signs fund_treasury_reward (must equal on-chain
# Config.treasury). Optional — falls back to HUB_MAINNET_WALLET when Config.treasury is the same
# key as the authority.
HUB_MAINNET_TREASURY_WALLET=
# Orquestra (https://orquestra.dev) — IDL indexing + REST instruction builders. Optional: when
# unset, verify-build.sh skips the IDL sync. TOKEN = dashboard session JWT (7-day, user-scoped;
# required to upload/update the IDL). API_KEY = project-scoped `b58_…` key from the project's
# API Keys tab (build/instructions endpoints; use in CI). PROJECT_ID overrides by-program lookup.
ORQUESTRA_API_URL=https://api.orquestra.dev
ORQUESTRA_TOKEN=
ORQUESTRA_API_KEY=
ORQUESTRA_PROJECT_ID=
# ORQUESTRA_PRIVATE=1 keeps the devnet project unlisted; ignored on mainnet-beta (always public).
ORQUESTRA_PRIVATE=
# scripts/hub-snapshot-ingest.ts (historical-metrics cron) — service-role key, server-side only,
# never ships to the browser. The web dashboard reads the mirrored rows with the anon key instead
# (web/.env.example: VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Source repo recorded in the verify PDA / Orquestra. Default: the cluster's git remote
# (devnet → origin = nodecattel/hubconnect, mainnet-beta → production = OTCHUB/hubconnect).
HUB_REPO_URL=
