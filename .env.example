# Copy to .env — never commit real values.
HELIUS_API_KEY=
HUB_CLUSTER=devnet
# Devnet RPC (Helius preferred; falls back to public devnet when key is empty)
HUB_RPC_URL=https://devnet.helius-rpc.com/?api-key=${HELIUS_API_KEY}
# Devnet deployer / funder wallet (never reused on mainnet)
HUB_WALLET=~/.config/solana/hubconnect-devnet.json
# §B5.1 devnet funder guard — abort test run if funder drops below this
HUB_DEVNET_MIN_SOL=2
# Orquestra (https://orquestra.dev) — IDL indexing + REST instruction builders. Optional: when
# unset, verify-build.sh skips the IDL sync. TOKEN = dashboard session JWT (7-day, user-scoped;
# required to upload/update the IDL). API_KEY = project-scoped `b58_…` key from the project's
# API Keys tab (build/instructions endpoints; use in CI). PROJECT_ID overrides by-program lookup.
ORQUESTRA_API_URL=https://api.orquestra.dev
ORQUESTRA_TOKEN=
ORQUESTRA_API_KEY=
ORQUESTRA_PROJECT_ID=
