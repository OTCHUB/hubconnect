# This file is only for local `npm run dev` / `vite preview` — the two real deploy targets each
# have their own committed env file (safe defaults, no secrets) plus an optional gitignored
# `.local` override for a paid RPC key:
#   env.production -> app.otchub.dev    : .env.production (+ .env.production.local)
#   env.devnet     -> devnet.otchub.dev : .env.devnet     (+ .env.devnet.local)
# See ../wrangler.jsonc for the Worker/route config and package.json's `build:devnet` /
# `deploy:production` / `deploy:devnet` scripts.
#
# Public RPC by default. For a paid RPC put the Helius URL in `.env.local` (gitignored):
# VITE_HUB_RPC_URL=https://devnet.helius-rpc.com/?api-key=<HELIUS_API_KEY>
# The key ships in the browser bundle — allowlist the deploy domain in the Helius dashboard.
VITE_HUB_RPC_URL=https://api.devnet.solana.com
VITE_HUB_CLUSTER=devnet
# Optional override; defaults to the IDL address (current devnet deploy: 7c5oPs9GvX8vrC5jVFketNx1ZLuPs7HeH8Qc4XJx7b7i)
# VITE_HUB_PROGRAM_ID=
# Historical-metrics feed (TVL/yield/supply trend charts) — anon key only, read-only, public by
# design (see ../src/hub/lib/supabaseHistory.ts). Optional: charts render "no history yet" when
# unset. Populated by ../../scripts/hub-snapshot-ingest.ts (service-role key, never here).
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
# Cloudflare Turnstile public site key — gates the devnet faucet's drip/mint-desk actions
# (see DripPage.tsx + workers/faucet.ts's TURNSTILE_SECRET_KEY). Unset = widget/verification
# skipped, so the faucet keeps working before a widget is provisioned in the Cloudflare dash.
# VITE_TURNSTILE_SITE_KEY=
