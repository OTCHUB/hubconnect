# Public RPC by default. For production builds put the Helius URL in `.env.production.local`
# (gitignored): VITE_HUB_RPC_URL=https://devnet.helius-rpc.com/?api-key=<HELIUS_API_KEY>
# The key ships in the browser bundle — allowlist app.otchub.dev in the Helius dashboard.
VITE_HUB_RPC_URL=https://api.devnet.solana.com
VITE_HUB_CLUSTER=devnet
# Optional override; defaults to the IDL address (devnet deploy: 3S2K4q9Kk9xkSSjqDb5jgp1cGC3mbqU2NfpCa3wJateL)
# VITE_HUB_PROGRAM_ID=
