{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@hub-sdk": ["../sdk/src/index.ts"],
      "@hub-sdk/*": ["../sdk/src/*"]
    }
  },
  "include": ["src", "../sdk/src", "../sdk/idl", "vite.config.ts", "tailwind.config.ts"]
}
