// Cloudflare Workers static-assets deployment of the standalone $HUB dashboard.
//
// Two isolated, simultaneously-deployable targets — each its own Worker script with its own
// asset bundle, so neither can leak the other's RPC / cluster / program id:
//   - mainnet-beta -> app.otchub.dev     (env.production; assets from ./dist)
//   - devnet       -> devnet.otchub.dev  (env.devnet;     assets from ./dist-devnet)
// devnet.otchub.dev is a public, risk-free sandbox for auditing tokenomics/mechanics/security
// ahead of mainnet launch; app.otchub.dev is permanently reserved for the mainnet-beta build.
//
// RPC / cluster / program id are baked in at build time from Vite env files, per mode, so a
// single `npm run build` (mainnet) or `npm run build:devnet` never crosses into the other's
// config — see `.env.production`(`.local`) and `.env.devnet`(`.local`). Worker `vars` cannot
// reach a static bundle, which is why this differentiation happens at build time, not here.
//
// Deploy: `npm run deploy:production` (app.otchub.dev) or `npm run deploy:devnet`
// (devnet.otchub.dev) — both always pass `--env` explicitly (wrangler warns otherwise, since
// this file now defines named environments). `npm run deploy` is a `deploy:production` alias.
// The top-level config below mirrors `env.production` exactly (same Worker, same route) purely
// so `wrangler dev`/other env-less commands still resolve to something sane.
{
  "name": "hubconnect-web",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash",
  },
  "routes": [{ "pattern": "app.otchub.dev", "custom_domain": true }],
  "observability": { "enabled": true },
  "env": {
    // Mainnet-beta — the only build ever served at app.otchub.dev. Same Worker name as the
    // top-level default (deliberately) so `wrangler deploy` and `wrangler deploy --env
    // production` always resolve to one script, never two competing claims on the domain.
    "production": {
      "name": "hubconnect-web",
      "assets": {
        "directory": "./dist",
        "not_found_handling": "single-page-application",
        "html_handling": "auto-trailing-slash",
      },
      "routes": [{ "pattern": "app.otchub.dev", "custom_domain": true }],
      "observability": { "enabled": true },
    },
    // Devnet sandbox — separate Worker, separate bundle, separate domain. Requires
    // `devnet.otchub.dev` to exist in the same Cloudflare zone as `otchub.dev` (one-time
    // DNS/zone setup); `wrangler deploy --env devnet` provisions the custom domain binding.
    //
    // Unlike `production` above, this env has a `main` script: workers/faucet.ts fronts the SPA,
    // handling `/api/faucet/*` (token drips + Mock OTC Desk minting, devnet.otchub.dev/drip)
    // itself and falling through to `env.ASSETS.fetch()` for everything else. `nodejs_compat` is
    // required for the Buffer usage in @solana/web3.js + the faucet's raw instruction builders.
    "devnet": {
      "name": "hubconnect-web-devnet",
      "main": "workers/faucet.ts",
      "compatibility_flags": ["nodejs_compat"],
      "assets": {
        "directory": "./dist-devnet",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "html_handling": "auto-trailing-slash",
      },
      "routes": [{ "pattern": "devnet.otchub.dev", "custom_domain": true }],
      "observability": { "enabled": true },
      // Rate-limit bucket for the faucet (per-wallet cooldowns + per-IP abuse guard). Created via
      // `wrangler kv namespace create FAUCET_KV --env devnet`; id filled in after creation.
      //
      // CURVE_KV is the bonding-curve simulation's own store (virtual reserves, trade log,
      // deposit-signature replay guard — see workers/bonding-curve.ts), isolated from the
      // faucet's rate-limit bucket. Created via `wrangler kv namespace create CURVE_KV --env devnet`.
      "kv_namespaces": [
        { "binding": "FAUCET_KV", "id": "877e6b420c51440d83e1a9fabfd6c0d4" },
        { "binding": "CURVE_KV", "id": "261211c9d7844bc0ac73a35223f8b808" },
      ],
      // HUB_RPC_URL is a `wrangler secret` (not a `vars` entry — Cloudflare rejects a secret and
      // a var sharing one binding name), set to a Helius devnet URL: the plain public
      // api.devnet.solana.com endpoint 403s Cloudflare Workers' egress IPs. faucet.ts falls back
      // to api.devnet.solana.com only when the secret is unset. Set/rotate with:
      //   wrangler secret put HUB_RPC_URL --env devnet
      //
      // CURVE_KEY is the curve treasury's own devnet keypair (JSON secret-key array), isolated
      // from FAUCET_KEY — holds the real ≥95% $HUB public float + collected SOL. Set with:
      //   wrangler secret put CURVE_KEY --env devnet
      //
      // TURNSTILE_SECRET_KEY gates /api/faucet/drip and /api/faucet/mint-desk behind a Cloudflare
      // Turnstile challenge (bot-abuse guard, independent of the IP/wallet cooldowns above).
      // Optional: verification is skipped when unset, so the faucet keeps working before it's
      // provisioned. Pair with VITE_TURNSTILE_SITE_KEY (web/.env.devnet(.local)) for the client
      // widget. Create a widget in the Cloudflare dash (Turnstile) pointed at devnet.otchub.dev,
      // then:
      //   wrangler secret put TURNSTILE_SECRET_KEY --env devnet
    },
  },
}
