{
  "name": "hubconnect",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "description": "$HUB Yield Optimizer Protocol — Activate-to-earn Boosted Yield layer for OTC desk NFTs on Solana",
  "license": "MIT",
  "scripts": {
    "build": "anchor build",
    "test": "anchor build && anchor build -p hub -- --features mock-jupiter && anchor test --skip-build --validator legacy",
    "test:devnet": "HUB_CLUSTER=devnet ts-mocha -p ./tsconfig.json -t 300000 tests/**/*.ts",
    "test:keeper": "ts-mocha -p ./tsconfig.json -t 60000 keeper/**/*.test.ts",
    "lint": "prettier --check tests sdk keeper scripts",
    "lint:fix": "prettier --write tests sdk keeper scripts",
    "devnet:mint": "ts-node -T scripts/devnet-hub-mint.ts",
    "devnet:metadata": "ts-node -T scripts/devnet-hub-metadata.ts",
    "devnet:upload-metadata": "ts-node -T scripts/devnet-hub-upload.ts",
    "orquestra:idl": "ts-node -T scripts/orquestra-idl.ts",
    "orquestra:send": "ts-node -T scripts/orquestra-send.ts",
    "devnet:desks": "ts-node -T scripts/devnet-mock-desks.ts",
    "devnet:faucet-authority": "ts-node -T scripts/devnet-faucet-authority.ts",
    "devnet:cycle": "ts-node -T scripts/devnet-yield-cycle.ts",
    "devnet:init-tier-fee": "ts-node -T scripts/devnet-init-tier-fee.ts",
    "devnet:mock-jupiter-setup": "ts-node -T scripts/mock-jupiter-setup.ts",
    "authority": "ts-node -T scripts/hub-authority.ts",
    "mainnet:metadata": "ts-node -T scripts/mainnet-hub-metadata.ts",
    "mainnet:airdrop-snapshot": "ts-node -T scripts/mainnet-airdrop-snapshot.ts",
    "mainnet:airdrop-distribute": "ts-node -T scripts/mainnet-distribute.ts",
    "mainnet:treasury-reward": "ts-node -T scripts/mainnet-distribute.ts --reward",
    "idl:copy": "node scripts/copy-idl.mjs",
    "snapshot:ingest": "ts-node -T scripts/hub-snapshot-ingest.ts",
    "keeper:epoch": "ts-node -T keeper/keeper/src/index.ts",
    "keeper:creator-fee": "ts-node -T keeper/creator-fee/src/index.ts",
    "keeper:lp": "ts-node -T keeper/lp/src/index.ts",
    "keeper:sweeper": "ts-node -T keeper/sweeper/src/index.ts",
    "keeper:treasury": "ts-node -T keeper/treasury/src/index.ts"
  },
  "dependencies": {
    "@anchor-lang/core": "^1.2.0",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.98.4"
  },
  "devDependencies": {
    "@irys/upload": "^0.0.15",
    "@irys/upload-solana": "^0.1.8",
    "@metaplex-foundation/mpl-core": "^1.10.0",
    "@metaplex-foundation/umi": "^1.5.1",
    "@metaplex-foundation/umi-bundle-defaults": "^1.5.1",
    "@metaplex-foundation/umi-web3js-adapters": "^1.5.1",
    "@types/bn.js": "^5.1.5",
    "@types/chai": "^4.3.16",
    "@types/mocha": "^10.0.10",
    "chai": "^4.4.1",
    "dotenv": "^17.4.2",
    "mocha": "^11.8.0",
    "prettier": "^3.9.6",
    "ts-mocha": "^11.1.0",
    "typescript": "^5.9.3"
  }
}
